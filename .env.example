# ---- Core ----
OQH_ENV=development
OQH_LOG_LEVEL=INFO
OQH_LOG_FORMAT=console          # console | json

# ---- Database (PostGIS) ----
OQH_DATABASE_URL=postgresql+psycopg://oqh:oqh@localhost:5432/openquyhoach

# ---- Object storage (S3-compatible; MinIO locally) ----
OQH_S3_ENDPOINT=http://localhost:9000
OQH_S3_REGION=us-east-1
OQH_S3_ACCESS_KEY=minioadmin
OQH_S3_SECRET_KEY=minioadmin
OQH_S3_BUCKET_ARTIFACTS=oqh-artifacts
OQH_S3_BUCKET_PUBLISHED=oqh-published
OQH_S3_SECURE=false

# ---- Queue ----
OQH_QUEUE_BACKEND=inline        # inline | redis
OQH_REDIS_URL=redis://localhost:6379/0

# ---- API ----
OQH_API_HOST=0.0.0.0
OQH_API_PORT=8000
OQH_API_CORS_ORIGINS=http://localhost:3100
OQH_API_MAX_BBOX_DEG2=4.0       # reject bbox queries larger than this (deg^2)
OQH_ADMIN_TOKEN=dev-admin-token # dev-only admin auth; replace via auth provider in prod

# ---- Ingestion / fetch security ----
OQH_FETCH_USER_AGENT=OpenQuyHoach/0.1 (+https://github.com/tang-vu/openquyhoach)
OQH_FETCH_MAX_BYTES=524288000   # 500 MiB hard cap per artifact
OQH_FETCH_TIMEOUT_SECONDS=60
OQH_FETCH_ALLOW_PRIVATE_IPS=false

# ---- AI (optional; system works with AI_ENABLED=false) ----
OQH_AI_ENABLED=false

# ---- Web ----
NEXT_PUBLIC_OQH_API_URL=http://localhost:8000
OQH_WEB_ADMIN_TOKEN=dev-admin-token
